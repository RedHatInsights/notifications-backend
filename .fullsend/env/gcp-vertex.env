# Vertex AI settings for pi's google-vertex (Gemini) provider, which needs all
# three variables below. Expanded on the runner (host_files expand: true).
# No secrets: GOOGLE_APPLICATION_CREDENTIALS points at the key-free WIF
# exchange config that `fullsend run` writes for the run's short-lived GitHub
# OIDC token, and the harness mounts both.
export GOOGLE_APPLICATION_CREDENTIALS=/tmp/.gcp-credentials.json
export GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT}
export GOOGLE_CLOUD_LOCATION=${CLOUD_ML_REGION}
