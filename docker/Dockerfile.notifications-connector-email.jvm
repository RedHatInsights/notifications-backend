####
# This Dockerfile is used in order to build a container that runs the Quarkus application in JVM mode
###

# Build the project
FROM registry.access.redhat.com/ubi9/openjdk-25:latest@sha256:f56abbc079feb946dda0d33532a277fba860b0aa5a550ab9d7e1b19acc767584 AS build
USER root
COPY . /home/jboss
WORKDIR /home/jboss
# mvnw is not committed to git; generate it from maven-wrapper.properties.
# Save and restore maven-wrapper.properties because wrapper:wrapper regenerates
# it using the bundled plugin version, silently dropping distributionSha256Sum
# and wrapperSha256Sum.
RUN cp .mvn/wrapper/maven-wrapper.properties /tmp/ && mvn wrapper:wrapper && cp /tmp/maven-wrapper.properties .mvn/wrapper/maven-wrapper.properties && ./mvnw -s .mvn/settings.xml clean package -Dmaven.test.skip -Dcheckstyle.skip -pl :notifications-connector-email -am --no-transfer-progress

# Build the container
FROM registry.access.redhat.com/ubi9/openjdk-25-runtime:latest@sha256:2ddacad5332f4e481353668f210623f7e7420f1561515f5686e5abd33cd6d38f

# Update the base image packages
USER root
# See https://www.mankier.com/8/microdnf
RUN microdnf upgrade --refresh --nodocs --setopt=install_weak_deps=0 -y
RUN microdnf clean all
# Add RedHat CAs on OS truststore (check https://certs.corp.redhat.com/ for more details)
COPY --from=build /home/jboss/recipients-resolver/src/main/resources/mtls-ca-validators.crt /etc/pki/ca-trust/source/anchors/mtls-ca-validators.crt
RUN update-ca-trust

USER jboss

ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en'
ENV JAVA_OPTIONS="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager -XX:+ExitOnOutOfMemoryError"

# Konflux preflight check requires a license
COPY --from=build /home/jboss/LICENSE.txt /licenses/LICENSE

# Use four distinct layers so if there are application changes the library layers can be re-used
COPY --from=build --chown=185 /home/jboss/connector-email/target/quarkus-app/lib/ /deployments/lib/
COPY --from=build --chown=185 /home/jboss/connector-email/target/quarkus-app/*.jar /deployments/
COPY --from=build --chown=185 /home/jboss/connector-email/target/quarkus-app/app/ /deployments/app/
COPY --from=build --chown=185 /home/jboss/connector-email/target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTIONS -jar /deployments/quarkus-run.jar"]
